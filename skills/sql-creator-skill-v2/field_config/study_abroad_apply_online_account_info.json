  "field_enums": {
  },

  "virtual_associations": [
    {
      "name": "关联留学规划信息",
      "target_table": "study_abroad_planning_info",
      "join_condition": "study_abroad_apply_online_account_info.student_id = study_abroad_planning_info.student_id AND study_abroad_planning_info.del = 0",
      "type": "many_to_one",
      "description": "多个网申账户信息记录可关联同一个学生的留学规划信息，通常通过 student_id 关联",
      "fields_mapping": {
        "student_id": "student_id"
      },
      "business_rule": ""
    },
    {
      "name": "关联学生基础信息",
      "target_table": "edu_student",
      "join_condition": "study_abroad_apply_online_account_info.student_id = edu_student.id",
      "type": "many_to_one",
      "description": "多个留学网申账户信息可关联同一个学生基础信息",
      "fields_mapping": {
        "student_id": "id"
      },
      "business_rule": ""
    },
    {
      "name": "关联留学网申主表",
      "target_table": "study_abroad_apply_online_info",
      "join_condition": "study_abroad_apply_online_account_info.student_id = study_abroad_apply_online_info.student_id AND study_abroad_apply_online_info.del = 0",
      "type": "one_to_many",
      "description": "一个学生的网申账户信息可对应多条网申记录",
      "fields_mapping": {
        "student_id": "student_id"
      },
      "business_rule": ""
    },
    {
      "name": "关联网申个人信息",
      "target_table": "study_abroad_apply_online_person_info",
      "join_condition": "study_abroad_apply_online_account_info.student_id = study_abroad_apply_online_person_info.student_id AND study_abroad_apply_online_person_info.del = 0",
      "type": "one_to_one",
      "description": "一个学生的网申账户信息可关联一条网申个人信息",
      "fields_mapping": {
        "student_id": "student_id"
      },
      "business_rule": ""
    }
  ],

  "calculated_fields": {},

  "business_constraints": {
    "student_id": "学生ID不能为空，是留学网申账户信息与学生、规划、网申主表关联的核心字段"
  },

  "business_rules": [
    {
      "rule": "留学规划主流程关联",
      "description": "在留学规划业务查询中，可通过 student_id 将网申账户信息与 study_abroad_planning_info 关联。"
    }
  ]
