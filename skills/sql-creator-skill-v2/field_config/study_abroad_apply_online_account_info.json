{
  "table_name": "study_abroad_apply_online_account_info",

  "field_aliases": {
    "id": ["自增ID", "主键ID"],
    "student_id": ["学生ID", "学员ID"],
    "email": ["网申邮箱", "申请邮箱", "邮箱账号"],
    "email_pwd": ["邮箱密码", "网申邮箱密码"],
    "ucas_account": ["UCAS账号", "UCAS账户"],
    "ucas_pwd": ["UCAS密码", "UCAS账户密码"],
