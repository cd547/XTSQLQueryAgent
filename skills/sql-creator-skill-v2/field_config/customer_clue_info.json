  "virtual_associations": [
    {
      "name": "关联客户主表",
      "target_table": "customer_info",
      "join_condition": "customer_info.code = customer_clue_info.customer_code",
      "type": "one_to_one",
      "description": "1条线索扩展信息对应1个客户（STRAIGHT_JOIN强制关联）"
    },
    {
      "name": "关联一级渠道",
      "target_table": "crm_channels",
      "join_condition": "crm_channels.channel_code = customer_clue_info.level1_channel_code",
      "type": "many_to_one",
      "description": "多条线索可归属同一一级渠道"
    },
    {
      "name": "关联二级渠道",
      "target_table": "crm_channels",
      "join_condition": "crm_channels.channel_code = customer_clue_info.level2_channel_code",
      "type": "conditional_many_to_one",
      "description": "多条线索可归属同一二级渠道",
      "fields": {
        "channel_name": "channel_name",
        "channel_type": "channel_type"
      },
      "business_rule": null,
      "conditions": [
        {
          "when": "customer_clue_info.special_channel = 7",
          "target_table": "admin_user_channel",
          "join_condition": "admin_user_channel.id = customer_clue_info.level2_channel_code AND customer_clue_info.special_channel = 7",
          "fields": {
            "channel_name": "name",
            "channel_type": "type"
          }
        }
      ]
    },
    {
      "name": "关联三级渠道",
      "target_table": "crm_channels",
      "join_condition": "crm_channels.channel_code = customer_clue_info.level3_channel_code",
      "type": "many_to_one",
      "description": "多条线索可归属同一三级渠道"
    },
    {
      "name": "关联四级渠道",
      "target_table": "crm_channels",
      "join_condition": "crm_channels.channel_code = customer_clue_info.level4_channel_code",
      "type": "many_to_one",
      "description": "多条线索可归属同一四级渠道"
    },
    {
      "name": "关联五级渠道",
      "target_table": "crm_channels",
      "join_condition": "crm_channels.channel_code = customer_clue_info.level5_channel_code",
      "type": "many_to_one",
      "description": "多条线索可归属同一五级渠道"
    },
    {
      "name": "关联负责顾问",
      "target_table": "admin_user",
      "join_condition": "admin_user.id = customer_clue_info.charge_person_id",
      "type": "many_to_one",
      "description": "多条线索可由同一顾问负责"
    },
    {
      "name": "关联前负责人",
      "target_table": "admin_user",
      "join_condition": "admin_user.id = customer_clue_info.before_charge_person_id",
      "type": "many_to_one",
      "description": "多条线索可有相同的前负责人"
    },
    {
      "name": "关联TMK人员",
      "target_table": "admin_user",
      "join_condition": "admin_user.id = customer_clue_info.tmk_user_id",
      "type": "many_to_one",
      "description": "多条线索可由同一TMK跟进"
    },
    {
      "name": "关联当前销售",
      "target_table": "admin_user",
      "join_condition": "admin_user.id = customer_clue_info.sale_user_id",
      "type": "many_to_one",
      "description": "多条线索可分配给同一销售"
    },
    {
      "name": "关联创建人",
      "target_table": "admin_user",
      "join_condition": "admin_user.id = customer_clue_info.create_by",
      "type": "many_to_one",
      "description": "多条线索可由同一后台用户录入"
    },
    {
      "name": "关联TMK递交人",
      "target_table": "admin_user",
      "join_condition": "admin_user.id = customer_clue_info.submitter_id",
      "type": "many_to_one",
      "description": "多条线索可由同一TMK递交"
    },
    {
      "name": "关联预负责人",
      "target_table": "admin_user",
      "join_condition": "admin_user.id = customer_clue_info.pre_sale_id",
      "type": "many_to_one",
      "description": "多条线索可有相同的预负责人（科桥/克勒）"
    },
    {
      "name": "关联首次创建人",
      "target_table": "admin_user",
      "join_condition": "admin_user.id = customer_clue_info.first_create_by",
      "type": "many_to_one",
      "description": "多条线索可有相同的首次创建人"
    },
    {
      "name": "关联咨询校区",
      "target_table": "edu_campus",
      "join_condition": "edu_campus.simple = customer_clue_info.consult_campus_value AND edu_campus.del = 0",
      "type": "many_to_one",
      "description": "多条线索可属于同一咨询校区",
      "business_rule": "通过campus.simple（校区别名）关联。campus.manager_id可进一步关联admin_user获取校区负责人"
    },
    {
      "name": "关联归属校区",
      "target_table": "edu_campus",
      "join_condition": "edu_campus.simple = customer_clue_info.campus_value AND edu_campus.del = 0",
      "type": "many_to_one",
      "description": "多条线索可属于同一归属校区",
      "business_rule": "通过campus.simple（校区别名）关联"
    },
    {
      "name": "关联录入人部门",
      "target_table": "admin_department_children",
      "join_condition": "admin_department_children.id = customer_clue_info.create_by_dept_id",
      "type": "many_to_one",
      "description": "多条线索的录入人可属于同一子部门",
      "business_rule": "admin_department_children可进一步关联admin_department（一级部门）"
    }
  ],
  "calculated_fields": {},
  "business_constraints": {
    "org": "org字段区分事业部：0-渊学通 1-科桥 2-克勒 3-择校圈",
    "data_permission": "查询时有数据权限控制：非白名单用户需限制create_by或渠道维护人或校区负责人"
  },
  "business_rules": []
}
