{
  "table_name": "customer_clue_pool",

  "field_aliases": {
    "customer_code": ["客户编码"],
    "admin_user_id": ["顾问ID", "TMK ID"],
    "enabled": ["启用状态"],
    "confirm_flag": ["确认状态", "线索确认状态"]
  },

  "field_enums": {
    "user_type": {
      "0": "TMK",
      "1": "顾问"
    },
    "confirm_flag": {
      "0": "无需确认",
      "1": "未确认",
      "2": "已确认"
    },
    "enabled": {
      "0": "失效",
      "1": "正常"
    }
  },

  "virtual_associations": [
    {
      "name": "关联客户主表",
      "target_table": "customer_info",
      "join_condition": "customer_info.code = customer_clue_pool.customer_code",
      "type": "many_to_one",
      "description": "多条线索池记录属于不同客户",
      "fields_mapping": {
        "code": "customer_code"
      },
      "business_rule": ""
    },
    {
      "name": "关联负责员工",
      "target_table": "admin_user",
      "join_condition": "admin_user.id = customer_clue_pool.admin_user_id",
      "type": "many_to_one",
      "description": "多条线索池记录可分配给同一员工（顾问或TMK）",
      "fields_mapping": {
        "id": "admin_user_id"
      },
      "business_rule": ""
    }
  ],

  "calculated_fields": {},

  "business_constraints": {
    "deleted": "查询时需加 deleted = 0 过滤已删除数据",
    "common_filter": "列表查询时常加 user_type = 1 AND enabled = 1（顾问类型、启用状态）"
  },

  "business_rules": []
}
