{
  "table_name": "edu_student",
  "field_aliases": {
    "edu_student_type_project_id":["课程体系"]
  },
  "field_enums": {
    "type":{
      "1":"学通学生",
      "2":"学通客户",
      "3":"科桥、克勒学生"
    },
    "org":{
      "1":"学通",
      "2":"科桥",
      "3":"克勒"
    },
    "edu_student_type_id":{
      "1":"全日制",
      "2":"培优",
      "3":"高中备考",
      "4":"双轨制",
      "5":"培优大客户(已删)",
      "6":"低龄备考",
      "7":"留学(已删)",
      "8":"未知(已删)"
    },
    "bank_account_status":{
      "0":"初始化",
      "2":"有效",
      "3":"注销"
    }
  },
  "virtual_associations": [
    {
      "name": "关联线索",
      "target_table": "customer_clue_info",
      "join_condition": "customer_clue_info.customer_code = edu_student.student_code",
      "type": "one_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联注册用户",
      "target_table": "my_user",
      "join_condition": "my_user.id = edu_student.my_user_id",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联小程序更新用户",
      "target_table": "my_user",
      "join_condition": "my_user.id = edu_student.update_my_user_id",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联分校",
      "target_table": "edu_campus_school",
      "join_condition": "edu_campus_school.id = edu_student.campus_school_id",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联学生类型（数据可直接参考field_enums中的edu_student_type_id字段）",
      "target_table": "edu_student_type",
      "join_condition": "edu_student_type.id = edu_student.edu_student_type_id",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联学生状态",
      "target_table": "edu_student_status",
      "join_condition": "edu_student_status.id = edu_student.edu_student_status_id",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联报读项目(课程体系)",
      "target_table": "edu_student_type_project",
      "join_condition": "edu_student_type_project.id = edu_student.edu_student_type_project_id",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联证件类型",
      "target_table": "edu_student_certificates_type",
      "join_condition": "edu_student_certificates_type.id = edu_student.certificates_type",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联学校库-在读学校主表",
      "target_table": "crm_current_school",
      "join_condition": "crm_current_school.id = edu_student.inschool_id",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联学校库-目标学校主表",
      "target_table": "crm_target_school",
      "join_condition": "crm_target_school.id = edu_student.institutions_id",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联专业方向",
      "target_table": "crm_tag_definition",
      "join_condition": "crm_tag_definition.id = edu_student.direction_id and crm_tag_definition.tag_scope = 'MAJOR_DIRECTION'",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    }
  ],
  "calculated_fields": {},
  "business_constraints": {},
  "business_rules": [
    {
      "name": "在读学校（inschool）",
      "description": "如果inschool_id为空，则读inschool。否则读inschool_id对应的学校名称。）"
    },
    {
      "name": "目标学校（institutions）",
      "description": "如果institutions_id为空，则读institutions。否则读institutions_id对应的学校名称。）"
    },
    {
      "name": "专业方向（direction）",
      "description": "如果direction_id为空，则读direction。否则读direction_id对应的专业方向名称。）"
    }
  ]
}
