{
  "table_name": "edu_study",
  "field_aliases": {
    "id": ["排课ID"],
    "type": ["排课类型", "课程类型"],
    "status": ["排课状态"],
    "class_time_start": ["上课开始时间"],
    "class_time_end": ["上课结束时间"],
    "class_hour": ["课时"],
    "class_week": ["星期"],
    "edu_campus_school_class_id": ["教室ID"],
    "edu_course_exam_subject_name_id": ["四级科目名ID"],
    "edu_class_type_id": ["班型ID"],
    "edu_admin_user_id": ["授课老师ID"],
    "admin_user_id": ["操作人ID", "创建人ID"],
    "classin_course_id": ["classin网课ID"],
    "is_video": ["是否关联视频"]
  },
  "field_enums": {
    "type": {"1": "线下课", "2": "网课", "3": "活动(教研活动)", "4": "classin网课"},
    "status": {"1": "未结课", "2": "已结课"},
    "class_week": {"0": "周日", "1": "周一", "2": "周二", "3": "周三", "4": "周四", "5": "周五", "6": "周六"},
    "english_teaching": {"1": "否", "2": "是"},
    "jingsai_teaching": {"1": "否", "2": "是"},
    "trial_teaching": {"1": "否", "2": "是"},
    "del": {"0": "正常", "1": "删除"}
  },
  "virtual_associations": [
    {
      "name": "关联科目名称",
      "target_table": "edu_course_exam_subject_name",
      "join_condition": "edu_course_exam_subject_name.id = edu_study.edu_course_exam_subject_name_id",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联班级类型",
      "target_table": "edu_class_type",
      "join_condition": "edu_class_type.id = edu_study.edu_class_type_id",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联上课老师",
      "target_table": "admin_user",
      "join_condition": "admin_user.id = edu_study.edu_admin_user_id",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联操作人",
      "target_table": "admin_user",
      "join_condition": "admin_user.id = edu_study.admin_user_id",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联教室",
      "target_table": "edu_campus_school_class",
      "join_condition": "edu_campus_school_class.id = edu_study.edu_campus_school_class_id",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    },
    {
      "name": "关联更新人",
      "target_table": "admin_user",
      "join_condition": "admin_user.id = edu_study.update_admin_user_id",
      "type": "many_to_one",
      "description": "",
      "business_rule": ""
    }
  ],
  "calculated_fields": {},
  "business_constraints": {
    "del_required": "所有查询必须加 a.del = 0（强制逻辑删除过滤）"
  },
  "business_rules": [
    {
      "name": "非教研活动",
      "description": "type IN (1,2,4)"
    },
    {
      "name": "教研活动",
      "description": "type=3 教研活动场景下，edu_campus_school_class_id 可为 NULL"
    },
    {
      "name": "class_time_start和class_time_end格式",
      "description": "class_time_start和class_time_end是13位时间戳"
    },
    {
      "name": "科目名称展示",
      "description": "根据edu_course_exam_subject_name_id，通过关联 edu_course_exam_subject（三级）、edu_course_exam（二级）、edu_course（一级），按 '一级-二级-三级-四级' 的顺序拼接展示，例如使用 CONCAT(c1.name, '-', c2.name, '-', c3.name, '-', c4.name) AS full_subject_name"
    },
    {
      "name": "授课形式展示",
      "description": "CASE \n  WHEN es.english_teaching = 2 AND es.jingsai_teaching = 2 THEN CONCAT('英语授课，竞赛', CASE WHEN es.trial_teaching = 2 THEN '，试听课' ELSE '' END) \n  WHEN es.english_teaching = 2 AND es.jingsai_teaching = 1 THEN CONCAT('英语授课', CASE WHEN es.trial_teaching = 2 THEN '，试听课' ELSE '' END) \n  WHEN es.english_teaching = 1 AND es.jingsai_teaching = 2 THEN CONCAT('竞赛', CASE WHEN es.trial_teaching = 2 THEN '，试听课' ELSE '' END) \n  ELSE CASE WHEN es.trial_teaching = 2 THEN '试听课' ELSE '常规课' END \nEND"
    },
    {
      "name": "小时数计算",
      "description": "(class_time_end - class_time_start) / 3600000"
    },
    {
      "name": "调课状态派生",
      "description": "EXISTS (SELECT 1 FROM edu_adjust_study WHERE old_study_id = a.id AND del = 0 AND ((adjust_status = 3) OR (adjust_status = 1 AND valid = 1)))"
    }
  ]
}
