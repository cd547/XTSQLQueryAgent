    {
      "name": "study_abroad_apply_online_account_info",
      "description": "留学网申账户信息表",
      "tags": ["留学", "网申", "账户"],
      "related_tables": [
        "study_abroad_planning_info",
        "edu_student"
      ],
      "business_constraints": [
        "student_id: 关联学生ID，通常关联 study_abroad_planning_info.student_id 或 edu_student.id",
        "查询留学网申账户信息时，通常以 student_id 作为学生维度关联字段"
      ],
      "business_rules": [
        {
          "rule": "网申账户归属学生",
          "description": "一个学生可以维护网申账户信息，查询规划信息时可通过 student_id 关联该学生的网申账户。"
        }
      ]
