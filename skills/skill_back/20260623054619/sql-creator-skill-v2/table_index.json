        "study_abroad_offer_info",
        "study_abroad_proofread_book",
        "edu_student"
      ],
      "business_constraints": [
        "student_id: 关联学生ID",
        "book_id: 关联 study_abroad_proofread_book.id",
        "id: 可被 study_abroad_apply_online_school_info.apply_online_info_id 引用",
        "id: 可被 study_abroad_offer_info.apply_online_id 引用"
      ],
      "business_rules": [
