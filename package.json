{
  "name": "xt-sql-query-agent",
  "version": "1.0.0",
  "description": "基于 LLM 的智能 SQL 查询分析 Agent",
  "author": "XTSQL Team",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run wait-and-frontend\"",
    "wait-and-frontend": "node wait-for-backend.js && npm run dev:frontend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "electron:dev": "concurrently \"npm run dev:frontend\" \"electron .\"",
    "electron:build": "npm run build:frontend && electron-builder",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build"
  },
  "build": {
    "appId": "com.xt.sqlqueryagent",
    "productName": "XTSQLQueryAgent",
    "directories": {
      "output": "dist"
    },
    "icon": "icons/app",
    "files": [
      "package.json",
      "electron/**/*",
      "frontend/dist/**/*"
    ],
    "asar": true,
    "win": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
